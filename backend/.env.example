# 复制为 backend/.env 后填写；不填 Key 系统会自动走降级模板（全流程仍可演示）
OPENAI_API_KEY=
# 可选：兼容端点（百炼 / DeepSeek / 其他 OpenAI 兼容代理）
OPENAI_BASE_URL=
# 可选：模型名，默认 gpt-4o-mini
OPENAI_MODEL=

# 其余可调项（一般不用改，见 backend/app/core/config.py）
# COMPAT_LLM_MAX_RETRIES=2
# COMPAT_LLM_TIMEOUT_SECONDS=60
# COMPAT_LLM_MAX_OUTPUT_TOKENS=2000
# COMPAT_LLM_CONTEXT_LINES=20
# COMPAT_JSDOM_TIMEOUT_SECONDS=5
